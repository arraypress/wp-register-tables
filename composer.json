{
  "name": "arraypress/wp-register-tables",
  "description": "A declarative WordPress admin table registration system for BerlinDB-powered plugins",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/arraypress/wp-register-tables/",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3",
    "arraypress/wp-composer-assets": "dev-main",
    "arraypress/wp-date-utils": "dev-main",
    "arraypress/wp-countries": "dev-main",
    "arraypress/wp-status-badge": "dev-main",
    "arraypress/wp-field-kit": "dev-main",
    "arraypress/wp-money": "dev-main",
    "arraypress/wp-format-utils": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\RegisterTables\\": "src/"
    },
    "files": [
      "src/Functions.php"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": {
      "arraypress/wp-field-kit": "source",
      "*": "dist"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-register-tables/issues",
    "source": "https://github.com/arraypress/wp-register-tables"
  },
  "keywords": [
    "wordpress",
    "admin-tables",
    "wp-list-table",
    "berlindb",
    "admin-interface",
    "table-registration",
    "list-tables",
    "wp-admin",
    "crud",
    "data-tables",
    "declarative-api"
  ],
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist",
    "docs:verify": "php vendor/arraypress/wp-field-kit/bin/verify-docs.php --calls=register_admin_table README.md"
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\RegisterTables\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "/tests/bootstrap.php"
    ]
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/arraypress/wp-field-kit.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/arraypress/wp-money.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/arraypress/wp-format-utils.git"
    }
  ]
}
