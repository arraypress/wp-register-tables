{
  "name": "arraypress/wp-rate-format",
  "version": "1.0.0",
  "description": "A WordPress library for formatting, rendering, sanitizing, and validating rates and percentages",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/arraypress/wp-rate-format/",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=7.4",
    "arraypress/wp-currencies": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\RateFormat\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-rate-format/issues",
    "source": "https://github.com/arraypress/wp-rate-format"
  },
  "keywords": [
    "wordpress",
    "rate",
    "percentage",
    "currency",
    "formatting",
    "sanitization",
    "validation",
    "stripe",
    "discount",
    "commission"
  ]
}